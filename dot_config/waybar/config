[
    {
        "layer": "top",
        "output": "DP-2",
        "position": "top",
        "height": 30,
        "modules-left": [
            "hyprland/workspaces",
            "hyprland/window"
        ],
        "modules-center": [
            "clock"
        ],
        "modules-right": [
            "custom/media",
            "pulseaudio",
            "bluetooth",
            "cpu",
            "memory",
            "tray"
        ],
        "hyprland/workspaces": {
            "disable-scroll": true,
            "all-outputs": false,
            "format": "❰<span color=\"#ebdbb2\"> {name} </span>❱"
        },
        "hyprland/window": {
            "separate-outputs": true
        },
        "idle_inhibitor": {
            "format": "{icon}",
            "format-icons": {
                "activated": "",
                "deactivated": ""
            }
        },
        "tray": {
            "icon-size": 14,
            "spacing": 10
        },
        "clock": {
            "format-alt": "{:%A, %B %d at %H:%M}",
            "format": "{:%Y-%m-%d - %H:%M}"
        },
        "cpu": {
            "format": "{usage}% ",
            "on-click": "alacritty -t 'Floating Terminal' -e btop"
        },
        "memory": {
            "interval": 30,
            "format": "{used:0.1f}/{total:0.1f}G "
        },
        "network": {
            "format-wifi": "{essid} ({signalStrength}%) ",
            "format-ethernet": "{ifname}: {ipaddr} ",
            "format-disconnected": "Disconnected !"
        },
        "pulseaudio": {
            "format": "{volume}% {icon}",
            "format-bluetooth": "{volume}% {icon}",
            "format-muted": "",
            "format-icons": {
                "headphones": "",
                "handsfree": "",
                "headset": "",
                "phone": "",
                "portable": "",
                "car": "",
                "default": [
                    "",
                    ""
                ]
            },
            "on-click": "pavucontrol"
        },
        "custom/media": {
            // "return-type": "json",
            "exec": "playerctl metadata --format '{{ playerName }}: {{ default(artist, 'player') }} - {{ trunc(title, 40) }}'",
            // "exec": "~/.config/waybar/scripts/media/player.py",
            "interval": "1",
            "on-click": "playerctl play-pause",
            "on-scroll-up": "playerctl previous",
            "on-scroll-down": "playerctl next"
        }
    },
    {
        "output": "DP-1",
        "layer": "top",
        "position": "top",
        "height": "30",
        "modules-left": [
            "hyprland/workspaces",
            "hyprland/window"
        ],
        "modules-right": [
            "clock"
        ],
        "hyprland/workspaces": {
            "disable-scroll": true,
            "all-outputs": false,
            "format": "❰<span color=\"#ebdbb2\"> {name} </span>❱"
        },
        "hyprland/window": {
            "separate-outputs": true
        },
        "clock": {
            "format-alt": "{:%A, %B %d at %H:%M}",
            "format": "{:%Y-%m-%d - %H:%M}"
        }
    }
]
